# --- Google Sheets jako databaze ---------------------------------------------
# ID tabulky = cast URL mezi /d/ a /edit
GOOGLE_SHEET_ID=

# Service account z Google Cloud (viz README, sekce "Napojeni Google Sheets")
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Privatni klic vcetne -----BEGIN PRIVATE KEY----- ... na jednom radku s \n
GOOGLE_PRIVATE_KEY=

# Dokud nejsou promenne vyplnene, aplikace uklada data lokalne
# do data/local-store.json a dashboard na to upozorni.

# --- Scraper ------------------------------------------------------------------
# Cim se hlasime Heurece. Vychozi hodnota je v src/lib/fetchHtml.ts.
SCRAPER_USER_AGENT=
